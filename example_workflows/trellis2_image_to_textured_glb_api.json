{
  "1": {"class_type": "LoadImage", "inputs": {"image": "trellis2_input.png"},
        "_meta": {"title": "Load Image"}},
  "2": {"class_type": "CCTechTrellis2BiRefNetLoader",
        "inputs": {"birefnet": "pixal3d/extras/birefnet/model.safetensors"}},
  "3": {"class_type": "RemoveBackground", "inputs": {"bg_removal_model": ["2", 0], "image": ["1", 0]}},
  "4": {"class_type": "CCTechTrellis2PrepareImage",
        "inputs": {"image": ["1", 0], "mask": ["3", 0], "pipeline": "trellis2"}},
  "5": {"class_type": "CCTechTrellis2DINOv3Loader",
        "inputs": {"dinov3": "trellis2/facebook/dinov3-vitl16-pretrain-lvd1689m/model.safetensors",
                   "naf": "none"}},
  "6": {"class_type": "Trellis2Conditioning", "inputs": {"clip_vision_model": ["5", 0], "image": ["4", 0]}},
  "7": {"class_type": "CCTechTrellis2ModelLoader",
        "inputs": {"sparse_structure": "trellis2/ckpts/ss_flow_img_dit_1_3B_64_bf16.safetensors",
                   "shape_512": "trellis2/ckpts/slat_flow_img2shape_dit_1_3B_512_bf16.safetensors",
                   "shape_1024": "trellis2/ckpts/slat_flow_img2shape_dit_1_3B_1024_bf16.safetensors",
                   "texture": "trellis2/ckpts/slat_flow_imgshape2tex_dit_1_3B_1024_bf16.safetensors",
                   "weight_dtype": "default"}},
  "8": {"class_type": "CCTechTrellis2VAELoader",
        "inputs": {"structure_decoder": "trellis2/microsoft/TRELLIS-image-large/ckpts/ss_dec_conv3d_16l8_fp16.safetensors",
                   "shape_decoder": "trellis2/ckpts/shape_dec_next_dc_f16c32_fp16.safetensors",
                   "texture_decoder": "trellis2/ckpts/tex_dec_next_dc_f16c32_fp16.safetensors"}},
  "9": {"class_type": "CFGOverride", "inputs": {"model": ["7", 0], "cfg": 1.0, "start_percent": 0.667, "end_percent": 1.0},
        "_meta": {"title": "sparse structure: guidance interval [0.6, 1.0]"}},
  "10": {"class_type": "RescaleCFG", "inputs": {"model": ["9", 0], "multiplier": 0.7},
         "_meta": {"title": "sparse structure: guidance_rescale 0.7"}},
  "11": {"class_type": "ModelSamplingSD3", "inputs": {"model": ["10", 0], "shift": 5.0},
         "_meta": {"title": "sparse structure: rescale_t 5.0"}},
  "12": {"class_type": "EmptyTrellis2LatentStructure", "inputs": {"batch_size": 1}},
  "13": {"class_type": "KSampler",
         "inputs": {"model": ["11", 0], "seed": 42, "steps": 12, "cfg": 7.5, "sampler_name": "euler",
                    "scheduler": "normal", "positive": ["6", 0], "negative": ["6", 1],
                    "latent_image": ["12", 0], "denoise": 1.0},
         "_meta": {"title": "KSampler (sparse structure)"}},
  "14": {"class_type": "VaeDecodeStructureTrellis2", "inputs": {"samples": ["13", 0], "vae": ["8", 0], "resolution": "32"}},
  "15": {"class_type": "CCTechTrellis2StructureCleanup",
         "inputs": {"voxel": ["14", 0], "fill_holes": true, "hole_fill_algorithm": "remove_small_holes",
                    "hole_structure": 1, "hole_iterations": 1, "keep_only_shell": true}},
  "16": {"class_type": "Trellis2ShapeStage", "inputs": {"positive": ["6", 0], "negative": ["6", 1], "voxel": ["15", 0]}},
  "17": {"class_type": "CFGOverride", "inputs": {"model": ["7", 0], "cfg": 1.0, "start_percent": 0.769, "end_percent": 1.0},
         "_meta": {"title": "shape: guidance interval [0.6, 1.0]"}},
  "18": {"class_type": "RescaleCFG", "inputs": {"model": ["17", 0], "multiplier": 0.5},
         "_meta": {"title": "shape: guidance_rescale 0.5"}},
  "19": {"class_type": "KSampler",
         "inputs": {"model": ["18", 0], "seed": 42, "steps": 12, "cfg": 7.5, "sampler_name": "euler",
                    "scheduler": "normal", "positive": ["16", 0], "negative": ["16", 1],
                    "latent_image": ["16", 2], "denoise": 1.0},
         "_meta": {"title": "KSampler (shape 512)"}},
  "20": {"class_type": "Trellis2UpsampleStage",
         "inputs": {"positive": ["16", 0], "negative": ["16", 1], "shape_latent": ["19", 0],
                    "vae": ["8", 0], "target_resolution": 1024}},
  "21": {"class_type": "KSampler",
         "inputs": {"model": ["18", 0], "seed": 42, "steps": 12, "cfg": 7.5, "sampler_name": "euler",
                    "scheduler": "simple", "positive": ["20", 0], "negative": ["20", 1],
                    "latent_image": ["20", 2], "denoise": 1.0},
         "_meta": {"title": "KSampler (shape 1024)"}},
  "22": {"class_type": "Trellis2TextureStage",
         "inputs": {"positive": ["20", 0], "negative": ["20", 1], "shape_latent": ["21", 0]}},
  "23": {"class_type": "KSampler",
         "inputs": {"model": ["7", 0], "seed": 42, "steps": 12, "cfg": 1.0, "sampler_name": "euler",
                    "scheduler": "normal", "positive": ["22", 0], "negative": ["22", 1],
                    "latent_image": ["22", 2], "denoise": 1.0},
         "_meta": {"title": "KSampler (texture, guidance 1.0)"}},
  "24": {"class_type": "VaeDecodeShapeTrellis", "inputs": {"samples": ["21", 0], "vae": ["8", 0]}},
  "25": {"class_type": "VaeDecodeTextureTrellis",
         "inputs": {"samples": ["23", 0], "vae": ["8", 1], "shape_subdivides": ["24", 1]}},
  "26": {"class_type": "FillHoles",
         "inputs": {"mesh": ["24", 0], "max_perimeter": 0.03, "weld_epsilon_rel": 1e-05,
                    "max_vertices": 16, "fill_chains": false}},
  "27": {"class_type": "RemeshMesh",
         "inputs": {"mesh": ["26", 0], "resolution": 1024, "sign_mode": "udf",
                    "sign_mode.qef": false, "sign_mode.drop_inverted_components": false,
                    "sign_mode.drop_enclosed_components": false, "band": 1.0, "project_back": 0.0,
                    "fix_poles": false, "smooth_iters": 0, "drop_small_components": 0.01,
                    "precluster_max_verts": 20000000},
         "_meta": {"title": "Remesh (sidecar: narrow-band DC, band 1, no projection)"}},
  "28": {"class_type": "DecimateMesh",
         "inputs": {"mesh": ["27", 0], "target_face_count": 500000, "placement_mode": "midpoint"}},
  "29": {"class_type": "MeshSmoothNormals", "inputs": {"mesh": ["28", 0], "crease_angle": 180.0}},
  "30": {"class_type": "UnwrapMesh",
         "inputs": {"mesh": ["29", 0], "segmenter": "pec", "resolution": 2048, "padding": 1,
                    "weld_distance": 0.0002}},
  "31": {"class_type": "BakeTextureFromVoxel",
         "inputs": {"mesh": ["30", 0], "voxel_colors": ["25", 0], "texture_size": 2048,
                    "reference_mesh": ["24", 0]}},
  "32": {"class_type": "ApplyTextureToMesh",
         "inputs": {"mesh": ["30", 0], "base_color": ["31", 0], "metallic": ["31", 1], "roughness": ["31", 2]}},
  "33": {"class_type": "MeshSmoothNormals", "inputs": {"mesh": ["32", 0], "crease_angle": 180.0}},
  "34": {"class_type": "SaveGLB", "inputs": {"mesh": ["33", 0], "filename_prefix": "3d/trellis2"},
         "_meta": {"title": "Save 3D Model (PBR textured)"}}
}
