{
  "1": {
    "class_type": "LoadImage",
    "inputs": {"image": "triposg_input.png"},
    "_meta": {"title": "Load Image (subject on a plain background, or with alpha)"}
  },
  "2": {
    "class_type": "CCTechTripoSGRMBGLoader",
    "inputs": {"model": "RMBG-1.4"},
    "_meta": {"title": "TripoSG RMBG Loader"}
  },
  "3": {
    "class_type": "CCTechTripoSGModelLoader",
    "inputs": {"model": "TripoSG", "dtype": "auto"},
    "_meta": {"title": "TripoSG Model Loader"}
  },
  "4": {
    "class_type": "CCTechTripoSGPrepareImage",
    "inputs": {
      "image": ["1", 0],
      "mask": ["1", 1],
      "rmbg": ["2", 0],
      "remove_background": true,
      "padding_ratio": 0.1,
      "background": "white"
    },
    "_meta": {"title": "TripoSG Prepare Image"}
  },
  "5": {
    "class_type": "CCTechTripoSGSampler",
    "inputs": {
      "triposg_model": ["3", 0],
      "image": ["4", 0],
      "seed": 42,
      "steps": 50,
      "guidance_scale": 7.0,
      "num_tokens": 2048
    },
    "_meta": {"title": "TripoSG Sampler"}
  },
  "6": {
    "class_type": "CCTechTripoSGDecodeMesh",
    "inputs": {
      "triposg_model": ["3", 0],
      "shape_latent": ["5", 0],
      "dense_octree_depth": 8,
      "hierarchical_octree_depth": 9,
      "bounds": 1.005
    },
    "_meta": {"title": "TripoSG Decode Mesh"}
  },
  "7": {
    "class_type": "SaveGLB",
    "inputs": {"mesh": ["6", 0], "filename_prefix": "3d/triposg"},
    "_meta": {"title": "Save 3D Model"}
  }
}
