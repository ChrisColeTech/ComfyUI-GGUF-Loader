{
  "1": {"class_type": "LoadImage", "inputs": {"image": "pixal3d_input.png"},
        "_meta": {"title": "Load Image"}},
  "2": {"class_type": "CCTechTrellis2BiRefNetLoader",
        "inputs": {"birefnet": "pixal3d/extras/birefnet/model.safetensors"}},
  "3": {"class_type": "RemoveBackground", "inputs": {"bg_removal_model": ["2", 0], "image": ["1", 0]}},
  "4": {"class_type": "CCTechTrellis2PrepareImage",
        "inputs": {"image": ["1", 0], "mask": ["3", 0], "pipeline": "pixal3d"}},
  "5": {"class_type": "CCTechTrellis2DINOv3Loader",
        "inputs": {"dinov3": "pixal3d/extras/dinov3-vitl16/model.safetensors",
                   "naf": "pixal3d/naf/naf_release.pth"}},
  "6": {"class_type": "CCTechTrellis2MoGeLoader", "inputs": {"moge": "pixal3d/extras/moge-2-vitl/model.pt"}},
  "7": {"class_type": "MoGeInference",
        "inputs": {"moge_model": ["6", 0], "image": ["4", 0], "resolution_level": 9, "fov_x_degrees": 0.0,
                   "batch_size": 4, "force_projection": true, "apply_mask": true, "refine_steps": 3},
        "_meta": {"title": "MoGe-2 camera (sidecar estimate_camera)"}},
  "8": {"class_type": "MoGeGeometryToFOV", "inputs": {"moge_geometry": ["7", 0], "axis": "horizontal", "unit": "degrees"}},
  "9": {"class_type": "Pixal3DConditioning",
        "inputs": {"clip_vision_model": ["5", 0], "image": ["4", 0], "camera_angle_x": ["8", 0]}},
  "10": {"class_type": "CCTechTrellis2ModelLoader",
         "inputs": {"sparse_structure": "pixal3d/split/Sparse/ss_flow_img_dit_1_3B_64_bf16.gguf",
                    "shape_512": "pixal3d/split/shape/slat_flow_img2shape_dit_1_3B_512_bf16.gguf",
                    "shape_1024": "pixal3d/split/shape/slat_flow_img2shape_dit_1_3B_1024_bf16.gguf",
                    "texture": "pixal3d/split/texture/slat_flow_imgshape2tex_dit_1_3B_1024_bf16.gguf",
                    "weight_dtype": "default"}},
  "11": {"class_type": "CCTechTrellis2VAELoader",
         "inputs": {"structure_decoder": "pixal3d/split/decoder/ss_dec_conv3d_16l8_fp16.safetensors",
                    "shape_decoder": "pixal3d/split/decoder/shape_dec_next_dc_f16c32_fp16.safetensors",
                    "texture_decoder": "pixal3d/split/decoder/tex_dec_next_dc_f16c32_fp16.safetensors"}},
  "12": {"class_type": "CFGOverride", "inputs": {"model": ["10", 0], "cfg": 1.0, "start_percent": 0.667, "end_percent": 1.0},
         "_meta": {"title": "sparse structure: guidance interval [0.6, 1.0]"}},
  "13": {"class_type": "RescaleCFG", "inputs": {"model": ["12", 0], "multiplier": 0.7}},
  "14": {"class_type": "ModelSamplingSD3", "inputs": {"model": ["13", 0], "shift": 5.0}},
  "15": {"class_type": "EmptyTrellis2LatentStructure", "inputs": {"batch_size": 1}},
  "16": {"class_type": "KSampler",
         "inputs": {"model": ["14", 0], "seed": 42, "steps": 12, "cfg": 7.5, "sampler_name": "euler",
                    "scheduler": "normal", "positive": ["9", 0], "negative": ["9", 1],
                    "latent_image": ["15", 0], "denoise": 1.0},
         "_meta": {"title": "KSampler (sparse structure)"}},
  "17": {"class_type": "VaeDecodeStructureTrellis2", "inputs": {"samples": ["16", 0], "vae": ["11", 0], "resolution": "32"}},
  "18": {"class_type": "Trellis2ShapeStage", "inputs": {"positive": ["9", 0], "negative": ["9", 1], "voxel": ["17", 0]}},
  "19": {"class_type": "CFGOverride", "inputs": {"model": ["10", 0], "cfg": 1.0, "start_percent": 0.769, "end_percent": 1.0},
         "_meta": {"title": "shape: guidance interval [0.6, 1.0]"}},
  "20": {"class_type": "RescaleCFG", "inputs": {"model": ["19", 0], "multiplier": 0.5}},
  "21": {"class_type": "KSampler",
         "inputs": {"model": ["20", 0], "seed": 42, "steps": 12, "cfg": 7.5, "sampler_name": "euler",
                    "scheduler": "normal", "positive": ["18", 0], "negative": ["18", 1],
                    "latent_image": ["18", 2], "denoise": 1.0},
         "_meta": {"title": "KSampler (shape 512)"}},
  "22": {"class_type": "Trellis2UpsampleStage",
         "inputs": {"positive": ["18", 0], "negative": ["18", 1], "shape_latent": ["21", 0],
                    "vae": ["11", 0], "target_resolution": 1024}},
  "23": {"class_type": "KSampler",
         "inputs": {"model": ["20", 0], "seed": 42, "steps": 12, "cfg": 7.5, "sampler_name": "euler",
                    "scheduler": "simple", "positive": ["22", 0], "negative": ["22", 1],
                    "latent_image": ["22", 2], "denoise": 1.0},
         "_meta": {"title": "KSampler (shape 1024)"}},
  "24": {"class_type": "Trellis2TextureStage",
         "inputs": {"positive": ["22", 0], "negative": ["22", 1], "shape_latent": ["23", 0]}},
  "25": {"class_type": "KSampler",
         "inputs": {"model": ["10", 0], "seed": 42, "steps": 12, "cfg": 1.0, "sampler_name": "euler",
                    "scheduler": "normal", "positive": ["24", 0], "negative": ["24", 1],
                    "latent_image": ["24", 2], "denoise": 1.0},
         "_meta": {"title": "KSampler (texture, guidance 1.0)"}},
  "26": {"class_type": "VaeDecodeShapeTrellis", "inputs": {"samples": ["23", 0], "vae": ["11", 0]}},
  "27": {"class_type": "VaeDecodeTextureTrellis",
         "inputs": {"samples": ["25", 0], "vae": ["11", 1], "shape_subdivides": ["26", 1]}},
  "28": {"class_type": "FillHoles",
         "inputs": {"mesh": ["26", 0], "max_perimeter": 0.03, "weld_epsilon_rel": 1e-05,
                    "max_vertices": 16, "fill_chains": false}},
  "29": {"class_type": "RemeshMesh",
         "inputs": {"mesh": ["28", 0], "resolution": 1024, "sign_mode": "udf",
                    "sign_mode.qef": false, "sign_mode.drop_inverted_components": false,
                    "sign_mode.drop_enclosed_components": false, "band": 1.0, "project_back": 0.0,
                    "fix_poles": false, "smooth_iters": 0, "drop_small_components": 0.01,
                    "precluster_max_verts": 20000000}},
  "30": {"class_type": "DecimateMesh",
         "inputs": {"mesh": ["29", 0], "target_face_count": 400000, "placement_mode": "midpoint"}},
  "31": {"class_type": "MeshSmoothNormals", "inputs": {"mesh": ["30", 0], "crease_angle": 180.0}},
  "32": {"class_type": "UnwrapMesh",
         "inputs": {"mesh": ["31", 0], "segmenter": "pec", "resolution": 4096, "padding": 1,
                    "weld_distance": 0.0002}},
  "33": {"class_type": "BakeTextureFromVoxel",
         "inputs": {"mesh": ["32", 0], "voxel_colors": ["27", 0], "texture_size": 4096,
                    "reference_mesh": ["26", 0]}},
  "34": {"class_type": "ApplyTextureToMesh",
         "inputs": {"mesh": ["32", 0], "base_color": ["33", 0], "metallic": ["33", 1], "roughness": ["33", 2]}},
  "35": {"class_type": "MeshSmoothNormals", "inputs": {"mesh": ["34", 0], "crease_angle": 180.0}},
  "36": {"class_type": "SaveGLB", "inputs": {"mesh": ["35", 0], "filename_prefix": "3d/pixal3d"},
         "_meta": {"title": "Save 3D Model (PBR textured)"}}
}
